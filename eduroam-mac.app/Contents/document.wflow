				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Spustit shell skript</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash

# Vybrani certifikatu
choose_file() {
    local prompt="$1"
    osascript &lt;&lt;EOD
try
    set theFile to choose file with prompt "$prompt"
    POSIX path of theFile
on error
    return ""
end try
EOD
}

# Root.der
while true; do
    ROOT_CERT=$(choose_file "Vyber root.der certifikát stazeny z ISu")
    if [[ -z "$ROOT_CERT" ]]; then
        exit 0
    fi

    if file "$ROOT_CERT" | grep -qi "certificate"; then
        break
    else
        osascript -e 'display dialog "Toto neni spravny .der certifikat. Vyber znovu." buttons {"OK"} default button 1'
    fi
done

# User.p12
while true; do
    USER_CERT=$(choose_file "Vyber user-***.p12 certifikat stazeny z ISu")
    if [[ -z "$USER_CERT" ]]; then
        exit 0
    fi

    if openssl pkcs12 -in "$USER_CERT" -nokeys -info -passin pass:dummy &gt;/dev/null 2&gt;&amp;1; then
        break
    else
        # Check extension fallback
        if [[ "$USER_CERT" == *.p12 ]]; then
            break
        else
            osascript -e 'display dialog "Toto neni spravny p12 certifikat. Vyber znovu." buttons {"OK"} default button 1'
        fi
    fi
done

# Heslo pro user.p12
while true; do
    USER_CERT_PASS=$(osascript -e 'display dialog "Vloz heslo pro uzivatelsky .p12 certifikat z ISu:" default answer "" with hidden answer buttons {"OK"} default button 1' -e 'text returned of result')

    if [[ -z "$USER_CERT_PASS" ]]; then
        exit 0
    fi

    # Check password
    if openssl pkcs12 -in "$USER_CERT" -passin pass:"$USER_CERT_PASS" -nokeys -info &gt;/dev/null 2&gt;&amp;1; then
        break
    else
        osascript -e 'display dialog "Heslo neni spravne. Zkontroluj a zadej znovu. Mas spravne heslo? Mas spravny certifikat?" buttons {"OK"} default button 1'
    fi
done

# Encode
ROOT_B64=$(base64 &lt; "$ROOT_CERT" | tr -d '\n')
USER_B64=$(base64 &lt; "$USER_CERT" | tr -d '\n')

# Eduroam mobileconfig
PROFILE="/tmp/eduroam.mobileconfig"

cat &gt; "$PROFILE" &lt;&lt;EOF
&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" \
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd"&gt;
&lt;plist version="1.0"&gt;
&lt;dict&gt;
  &lt;key&gt;PayloadContent&lt;/key&gt;
  &lt;array&gt;
    &lt;!-- Root certificate --&gt;
    &lt;dict&gt;
      &lt;key&gt;PayloadType&lt;/key&gt;
      &lt;string&gt;com.apple.security.root&lt;/string&gt;
      &lt;key&gt;PayloadContent&lt;/key&gt;
      &lt;data&gt;$ROOT_B64&lt;/data&gt;
      &lt;key&gt;PayloadUUID&lt;/key&gt;
      &lt;string&gt;$(uuidgen)&lt;/string&gt;
      &lt;key&gt;PayloadIdentifier&lt;/key&gt;
      &lt;string&gt;edu.mendelu.rootcert&lt;/string&gt;
      &lt;key&gt;PayloadDisplayName&lt;/key&gt;
      &lt;string&gt;Eduroam Root Certificate&lt;/string&gt;
      &lt;key&gt;PayloadVersion&lt;/key&gt;
      &lt;integer&gt;1&lt;/integer&gt;
    &lt;/dict&gt;

    &lt;!-- User certificate (.p12) --&gt;
    &lt;dict&gt;
      &lt;key&gt;PayloadType&lt;/key&gt;
      &lt;string&gt;com.apple.security.pkcs12&lt;/string&gt;
      &lt;key&gt;Password&lt;/key&gt;
      &lt;string&gt;$USER_CERT_PASS&lt;/string&gt;
      &lt;key&gt;PayloadContent&lt;/key&gt;
      &lt;data&gt;$USER_B64&lt;/data&gt;
      &lt;key&gt;PayloadUUID&lt;/key&gt;
      &lt;string&gt;$(uuidgen)&lt;/string&gt;
      &lt;key&gt;PayloadIdentifier&lt;/key&gt;
      &lt;string&gt;edu.mendelu.usercert&lt;/string&gt;
      &lt;key&gt;PayloadDisplayName&lt;/key&gt;
      &lt;string&gt;Eduroam User Certificate&lt;/string&gt;
      &lt;key&gt;PayloadVersion&lt;/key&gt;
      &lt;integer&gt;1&lt;/integer&gt;
    &lt;/dict&gt;

    &lt;!-- Wi-Fi payload --&gt;
    &lt;dict&gt;
      &lt;key&gt;PayloadType&lt;/key&gt;
      &lt;string&gt;com.apple.wifi.managed&lt;/string&gt;
      &lt;key&gt;SSID_STR&lt;/key&gt;
      &lt;string&gt;eduroam&lt;/string&gt;
      &lt;key&gt;EncryptionType&lt;/key&gt;
      &lt;string&gt;WPA2&lt;/string&gt;
      &lt;key&gt;EAPClientConfiguration&lt;/key&gt;
      &lt;dict&gt;
        &lt;key&gt;AcceptEAPTypes&lt;/key&gt;
        &lt;array&gt;
          &lt;integer&gt;13&lt;/integer&gt; &lt;!-- EAP-TLS --&gt;
        &lt;/array&gt;
      &lt;/dict&gt;
      &lt;key&gt;PayloadUUID&lt;/key&gt;
      &lt;string&gt;$(uuidgen)&lt;/string&gt;
      &lt;key&gt;PayloadIdentifier&lt;/key&gt;
      &lt;string&gt;edu.mendelu.eduroamwifi&lt;/string&gt;
      &lt;key&gt;PayloadDisplayName&lt;/key&gt;
      &lt;string&gt;Eduroam Wi-Fi&lt;/string&gt;
      &lt;key&gt;PayloadVersion&lt;/key&gt;
      &lt;integer&gt;1&lt;/integer&gt;
    &lt;/dict&gt;
  &lt;/array&gt;

  &lt;!-- Profile metadata --&gt;
  &lt;key&gt;PayloadUUID&lt;/key&gt;
  &lt;string&gt;$(uuidgen)&lt;/string&gt;
  &lt;key&gt;PayloadIdentifier&lt;/key&gt;
  &lt;string&gt;edu.mendelu.eduroamprofile&lt;/string&gt;
  &lt;key&gt;PayloadDisplayName&lt;/key&gt;
  &lt;string&gt;Eduroam Setup&lt;/string&gt;
  &lt;key&gt;PayloadType&lt;/key&gt;
  &lt;string&gt;Configuration&lt;/string&gt;
  &lt;key&gt;PayloadVersion&lt;/key&gt;
  &lt;integer&gt;1&lt;/integer&gt;
&lt;/dict&gt;
&lt;/plist&gt;
EOF

open "$PROFILE"
open "x-apple.systempreferences:com.apple.Profiles-Settings.extension"
</string>
